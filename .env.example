# ─────────────────────────────────────────────────────────────────────────────
# AI Code Reviewer — Environment Variables
# Copy this file to .env and fill in your values.
# The app works WITHOUT any API key (static-analysis-only mode).
# ─────────────────────────────────────────────────────────────────────────────

# Choose your preferred LLM provider: groq | gemini | openai
LLM_PROVIDER=groq

# ── Groq (Free, very fast — recommended for students) ────────────────────────
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (Free tier available) ──────────────────────────────────────
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI (Paid) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── App Settings ─────────────────────────────────────────────────────────────
APP_TITLE=AI Code Reviewer
MAX_FILE_SIZE_MB=5
MAX_CODE_LINES=2000
